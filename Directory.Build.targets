<Project>

	<!-- COM-8889: MSBuild only auto-imports the NEAREST Directory.Build.targets walking up from the
		 project folder, so without this explicit import every Framework/** project silently lost the
		 repo-root rules (ts_out item exclusions, tsconfig copy suppression, NU1701 NoWarn). -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

	<!-- COM-8866: commit 825104acf (2023-04-24) removed the per-project "None Update Translations\*.xml"
	     copy-item with the intent of centralizing it here, but this file was never created, silently
	     breaking translations for every Extensions/Signum.* project with a Translations folder. -->
	<ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\Translations')">
		<None Include="Translations\*.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- COM-8197: The published Signum.TSGenerator 10.0.0 NuGet package writes the generated *.ts files with the
	     platform line ending (CRLF on Windows), while the repo stores them as LF (.gitattributes eol=lf; the generator
	     source normalizes to LF, the package build does not). Every build therefore left "ghost" changes in
	     Extensions/**/*.ts. Normalize the generated files back to LF right after the generator ran. -->
	<UsingTask TaskName="NormalizeGeneratedTsLineEndings" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Code Type="Fragment" Language="cs"><![CDATA[
foreach (var item in Files)
{
    var path = item.GetMetadata("FullPath");
    if (!File.Exists(path))
    {
        continue;
    }

    var text = File.ReadAllText(path);
    if (text.Contains("\r"))
    {
        File.WriteAllText(path, text.Replace("\r\n", "\n"));
    }
}
]]></Code>
		</Task>
	</UsingTask>

	<Target Name="NormalizeGeneratedTsLineEndings" AfterTargets="GenerateSignumTS">
		<ItemGroup>
			<_SignumT4s Include="$(MSBuildProjectDirectory)\**\*.t4s" />
			<_SignumGeneratedTs Include="@(_SignumT4s->'%(RootDir)%(Directory)%(Filename).ts')" />
		</ItemGroup>
		<NormalizeGeneratedTsLineEndings Files="@(_SignumGeneratedTs)" />
	</Target>

</Project>
